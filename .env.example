# Used by build-android.sh (required)
BACKEND_URL=https://your-api-domain.up.railway.app

# Optional for local frontend dev via start-web.sh
# BACKEND_URL_DEV=https://your-api-domain.up.railway.app

# Put this value in Railway API service variables (not used locally by scripts)
# CORS_ALLOW_ORIGINS=http://localhost:4200,capacitor://localhost,https://your-fe-domain.up.railway.app
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=none

# Optional: enable one-time Alembic recovery on existing, non-versioned schemas.
# Only set this in Railway when migrating a pre-Alembic database.
# AUTO_STAMP_EXISTING_SCHEMA=true
