# Android build script input (local machine)
BACKEND_URL=https://oisreports-production.up.railway.app
# Optional for local Angular dev
# BACKEND_URL_DEV=http://localhost:8000

# Backend runtime env (Railway service variables)
# DATABASE_URL is provided by Railway Postgres service reference
# Example in Railway variables UI:
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Comma-separated CORS origins
CORS_ALLOW_ORIGINS=http://localhost:4200,capacitor://localhost,https://your-frontend-domain
